# OCR
OCR_BACKEND=tesseract
TESSERACT_LANG=spa
OLLAMA_MODEL=qwen2.5:7b-instruct
VISION_OLLAMA_MODEL=minicpm-v:8b
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_AVAILABLE_MODELS=qwen2.5:7b-instruct,qwen2.5:14b-instruct,qwen3:8b
VISION_MODELS=minicpm-v:8b,mistral-small3.1,qwen2.5-vl:7b,qwen3-vl:8b
SPACY_ANONYMIZATION_ENABLED=1
SPACY_MODEL=es_core_news_md

# Pinecone (optional)
# Do not commit your real key.
PINECONE_API_KEY=
PINECONE_INDEX_HOST=
PINECONE_NAMESPACE=__default__
PINECONE_TEXT_FIELD=text
PINECONE_API_VERSION=2025-10
PINECONE_EMBEDDING_MODEL=multilingual-e5-large
CHUNK_MAX_TOKENS=300
CHUNK_OVERLAP_TOKENS=50
# Optional explicit tokenizer override, e.g. intfloat/multilingual-e5-large
CHUNK_TOKENIZER_NAME=
RETRIEVAL_FALLBACK_MODE=local_hybrid

# Elasticsearch (optional)
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=legal-corpus
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_VERIFY_CERTS=true
ELASTICSEARCH_TEXT_FIELD=text

LEGAL_CORPUS_PATH=data/legal/templates/measure_corpus.jsonl

OPENAI_API_KEY=tu_api_key
OPENAI_MODEL=gpt-5-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_AVAILABLE_MODELS=gpt-5-mini,gpt-5.4

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_AVAILABLE_MODELS=deepseek-chat,deepseek-reasoner

HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=deepseek-ai/DeepSeek-V3
HUGGINGFACE_BASE_URL=https://router.huggingface.co/v1
HUGGINGFACE_AVAILABLE_MODELS=deepseek-ai/DeepSeek-V3,deepseek-ai/DeepSeek-R1

MONGODB_URI=
MONGODB_DB=violence_judicial_ai
MONGODB_COLLECTION=processing_runs
MONGODB_AUTH_COLLECTION=auth_users
MONGODB_BENCHMARK_COLLECTION=benchmark_runs

# Authentication
APP_AUTH_USERNAME=admin
APP_AUTH_ROLE=admin
# Prefer hashed password in production. Generate with:
#   python -m src.scripts.hash_password "tu_password"
APP_AUTH_PASSWORD_HASH=
# Dev fallback only. Leave empty in production if APP_AUTH_PASSWORD_HASH is set.
APP_AUTH_PASSWORD=
APP_AUTH_REGISTRATION_ENABLED=true
APP_AUTH_REGISTRATION_DEFAULT_ROLE=operator
APP_SESSION_SECRET=cambiar-esta-clave-de-sesion
APP_SESSION_TTL_SECONDS=28800
APP_SESSION_COOKIE_SECURE=false
APP_LOGIN_WINDOW_SECONDS=900
APP_LOGIN_MAX_ATTEMPTS=5

ANTHROPIC_API_KEY=api_key_claude
ANTHROPIC_MODEL=claude-sonnet-4-6
